# Postgres. Для `npm run dev` поза Docker — localhost; у compose перевизначається на db.
# На проді: рядок Supabase Transaction pooler (порт 6543).
DATABASE_URL=postgres://hodimo:hodimo@localhost:5432/hodimo

# Токен бота від @BotFather. Ним перевіряється підпис initData з Telegram.
# Локально підійде будь-який рядок.
TELEGRAM_BOT_TOKEN=000000:local-dev-token

# Скільки секунд initData вважаються свіжими.
INITDATA_MAX_AGE_SECONDS=86400

# Telegram ID адмінів (через кому). Вони отримують роль admin при вході.
ADMIN_TELEGRAM_IDS=900001

# Лише локально: дозволяє фронту входити під тестовими юзерами (/dev). На проді — false.
DEV_LOGIN=true

# Часовий пояс для фільтрів «Сьогодні» / «Цими вихідними».
APP_TIMEZONE=Europe/Warsaw
